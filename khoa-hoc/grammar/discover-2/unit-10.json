  "summary": [
    {
      "tag": "Can I ...? · Xin phép",
      "note": "Sau can là chủ ngữ rồi động từ nguyên mẫu không có to. Can I...? phù hợp khi nói với bạn bè hoặc người thân.",
      "example": "Can I use the computer?",
      "formula": [
        [
          "Can",
          "+",
          "I",
          "+",
          "động từ nguyên mẫu",
          "?"
        ]
      ],
      "usage": "Sau can là chủ ngữ rồi động từ nguyên mẫu không có to.",
      "exampleVi": "Tôi có thể sử dụng máy tính được không?",
      "sentenceType": "Interrogative (Câu hỏi)"
    },
    {
      "tag": "May I ...? · Lịch sự hơn",
      "note": "May I...? có nghĩa gần với Can I...? nhưng lịch sự hơn. Sau may vẫn là động từ nguyên mẫu.",
      "example": "May I take a photo?",
      "formula": [
        [
          "May",
          "+",
          "I",
          "+",
          "động từ nguyên mẫu",
          "?"
        ]
      ],
      "usage": "May I...?",
      "exampleVi": "Tôi có thể chụp ảnh được không?",
      "sentenceType": "Interrogative (Câu hỏi)"
    },
    {
      "tag": "Câu trả lời",
      "note": "Có thể trả lời Yes, you can/may. Với lời từ chối, dùng No, you can't hoặc No, you may not. Mayn't ít dùng trong tiếng Anh Mỹ.",
      "example": "May I come in? No, you may not.",
      "formula": [
        [
          "Yes, you can / may."
        ],
        [
          "No, you can't / may not."
        ]
      ],
      "usage": "Có thể trả lời Yes, you can/may.",
      "exampleVi": "Tôi có thể vào được không? Không, bạn có thể không.",
      "sentenceType": "Interrogative (Câu hỏi)"
    },
    {
      "tag": "Động từ nguyên mẫu",
      "note": "Modal verbs can và may đi với động từ nguyên mẫu. Nói can share, may use; không nói can to share hoặc may uses.",
      "example": "Can we share the tablet?",
      "formula": [
        [
          "can / may",
          "+",
          "use / share / wash / invite"
        ]
      ],
      "usage": "Modal verbs can và may đi với động từ nguyên mẫu.",
      "exampleVi": "Chúng ta có thể chia sẻ máy tính bảng được không?",
      "sentenceType": "Interrogative (Câu hỏi)"
    }
