  "summary": [
    {
      "tag": "Khẳng định · Can",
      "note": "Can đứng sau chủ ngữ và trước động từ chính. Cấu trúc này dùng được với mọi chủ ngữ mà không thay đổi can.",
      "example": "A plant can grow.",
      "formula": [
        [
          "Chủ ngữ",
          "+",
          "can",
          "+",
          "động từ nguyên thể"
        ]
      ],
      "usage": "Can đứng sau chủ ngữ và trước động từ chính.",
      "exampleVi": "Một cây có thể phát triển.",
      "sentenceType": "Affirmative (Câu khẳng định)"
    },
    {
      "tag": "Động từ · Dạng nguyên thể",
      "note": "Dù chủ ngữ là he, she, it hay một danh từ số ít, động từ sau can vẫn giữ nguyên: It can move, không nói It can moves hoặc It can to move.",
      "example": "It can move.",
      "formula": [
        [
          "It",
          "+",
          "can",
          "+",
          "move"
        ],
        [
          "People",
          "+",
          "can",
          "+",
          "breathe"
        ]
      ],
      "usage": "Dù chủ ngữ là he, she, it hay một danh từ số ít, động từ sau can vẫn giữ nguyên: It can move, không nói It can moves hoặc It can to move.",
      "exampleVi": "Nó có thể di chuyển.",
      "sentenceType": "Affirmative (Câu khẳng định)"
    },
    {
      "tag": "Phủ định · Can't",
      "note": "Can't là dạng nói gọn của cannot. Sau can't, động từ vẫn ở dạng nguyên thể. Không dùng don't hoặc doesn't cùng với can.",
      "example": "A statue can't breathe.",
      "formula": [
        [
          "Chủ ngữ",
          "+",
          "can't / cannot",
          "+",
          "động từ nguyên thể"
        ]
      ],
      "usage": "Can't là dạng nói gọn của cannot.",
      "exampleVi": "Một bức tượng không thể thở được.",
      "sentenceType": "Negative (Câu phủ định)"
    },
    {
      "tag": "Câu hỏi · Can",
      "note": "Câu kể A rose can grow đổi thành Can a rose grow? Chỉ chuyển can lên đầu; động từ grow vẫn giữ nguyên.",
      "example": "Can a rose grow?",
      "formula": [
        [
          "Can",
          "+",
          "chủ ngữ",
          "+",
          "động từ nguyên thể",
          "?"
        ]
      ],
      "usage": "Câu kể A rose can grow đổi thành Can a rose grow?",
      "exampleVi": "Một bông hồng có thể phát triển?",
      "sentenceType": "Interrogative (Câu hỏi)"
    },
    {
      "tag": "Trả lời ngắn · Yes",
      "note": "Sau Yes, dùng đại từ thay cho người hoặc vật được hỏi rồi dùng can. Không lặp lại động từ chính trong câu trả lời ngắn.",
      "example": "Yes, it can.",
      "formula": [
        [
          "Can a plant grow?",
          "→",
          "Yes, it can."
        ],
        [
          "Can people move?",
          "→",
          "Yes, they can."
        ]
      ],
      "usage": "Sau Yes, dùng đại từ thay cho người hoặc vật được hỏi rồi dùng can.",
      "exampleVi": "Vâng, nó có thể.",
      "sentenceType": "Affirmative (Câu khẳng định)"
    },
    {
      "tag": "Trả lời ngắn · No",
      "note": "Sau No, dùng đại từ phù hợp rồi dùng can't. Không nói No, it doesn't và không lặp lại động từ chính.",
      "example": "No, it can't.",
      "formula": [
        [
          "Can a statue breathe?",
          "→",
          "No, it can't."
        ],
        [
          "Can benches grow?",
          "→",
          "No, they can't."
        ]
      ],
      "usage": "Sau No, dùng đại từ phù hợp rồi dùng can't.",
      "exampleVi": "Không, không thể được.",
      "sentenceType": "Negative (Câu phủ định)"
    },
    {
      "tag": "Đại từ · It và They",
      "note": "Một vật hoặc một con vật thường được thay bằng it; nhiều người hoặc nhiều vật được thay bằng they. Nhờ vậy câu trả lời ngắn khớp chính xác với chủ ngữ trong câu hỏi.",
      "example": "Can plants grow? Yes, they can.",
      "formula": [
        [
          "a rose",
          "→",
          "it"
        ],
        [
          "people / plants",
          "→",
          "they"
        ]
      ],
      "usage": "Một vật hoặc một con vật thường được thay bằng it; nhiều người hoặc nhiều vật được thay bằng they.",
      "exampleVi": "Cây cối có thể phát triển được không? Vâng, họ có thể.",
      "sentenceType": "Interrogative (Câu hỏi)"
    },
    {
      "tag": "Phát âm · Can và Can't",
      "note": "Trong câu khẳng định, can thường được đọc nhẹ. Với can't, con cần giữ rõ âm /t/ cuối để người nghe nhận ra nghĩa phủ định; đồng thời lên giọng nhẹ ở cuối câu hỏi Yes/No.",
      "example": "It can't move.",
      "formula": [
        [
          "It can move.",
          "·",
          "It can't move."
        ],
        [
          "Can it move?",
          "↗"
        ]
      ],
      "usage": "Trong câu khẳng định, can thường được đọc nhẹ.",
      "exampleVi": "Nó không thể di chuyển.",
      "sentenceType": "Negative (Câu phủ định)"
    }
  ],
