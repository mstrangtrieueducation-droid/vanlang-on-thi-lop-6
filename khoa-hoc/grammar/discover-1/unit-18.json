  "summary": [
    {
      "tag": "Lời khuyên · Should",
      "note": "Should đưa ra lời khuyên về hành động tốt, phù hợp hoặc an toàn. Nó đứng sau chủ ngữ và trước động từ chính.",
      "example": "You should run away.",
      "formula": [
        [
          "Chủ ngữ",
          "+",
          "should",
          "+",
          "động từ nguyên thể"
        ]
      ],
      "usage": "Should đưa ra lời khuyên về hành động tốt, phù hợp hoặc an toàn.",
      "exampleVi": "Bạn nên chạy đi.",
      "sentenceType": "Affirmative (Câu khẳng định)"
    },
    {
      "tag": "Lời khuyên · Shouldn't",
      "note": "Shouldn't là dạng nói gọn của should not. Sau shouldn't vẫn dùng động từ nguyên thể; không thêm don't hoặc doesn't.",
      "example": "He shouldn't talk to the fox.",
      "formula": [
        [
          "Chủ ngữ",
          "+",
          "shouldn't / should not",
          "+",
          "động từ nguyên thể"
        ]
      ],
      "usage": "Shouldn't là dạng nói gọn của should not.",
      "exampleVi": "Anh ta không nên nói chuyện với con cáo.",
      "sentenceType": "Negative (Câu phủ định)"
    },
    {
      "tag": "Động từ · Dạng nguyên thể",
      "note": "Should và động từ chính giữ nguyên với I, you, he, she, it, we và they. Nói She should close the door, không nói She should closes hoặc She should to close.",
      "example": "She should close the door.",
      "formula": [
        [
          "She",
          "+",
          "should",
          "+",
          "close the door"
        ],
        [
          "They",
          "+",
          "should",
          "+",
          "stop"
        ]
      ],
      "usage": "Should và động từ chính giữ nguyên với I, you, he, she, it, we và they.",
      "exampleVi": "Cô nên đóng cửa lại.",
      "sentenceType": "Affirmative (Câu khẳng định)"
    },
    {
      "tag": "Câu hỏi · Should",
      "note": "Câu hỏi bắt đầu bằng Should, tiếp theo là chủ ngữ và động từ nguyên thể. Không dùng Do hoặc Does trước should.",
      "example": "Should I cross the river?",
      "formula": [
        [
          "Should",
          "+",
          "chủ ngữ",
          "+",
          "động từ nguyên thể",
          "?"
        ]
      ],
      "usage": "Câu hỏi bắt đầu bằng Should, tiếp theo là chủ ngữ và động từ nguyên thể.",
      "exampleVi": "Có nên qua sông không?",
      "sentenceType": "Interrogative (Câu hỏi)"
    },
    {
      "tag": "Trả lời ngắn · Yes",
      "note": "Sau Yes, dùng đại từ phù hợp rồi dùng should. Không lặp lại động từ chính trong câu trả lời ngắn.",
      "example": "Yes, you should.",
      "formula": [
        [
          "Should I stop?",
          "→",
          "Yes, you should."
        ],
        [
          "Should they play outside?",
          "→",
          "Yes, they should."
        ]
      ],
      "usage": "Sau Yes, dùng đại từ phù hợp rồi dùng should.",
      "exampleVi": "Có, bạn nên làm vậy.",
      "sentenceType": "Affirmative (Câu khẳng định)"
    },
    {
      "tag": "Trả lời ngắn · No",
      "note": "Sau No, dùng đại từ phù hợp rồi dùng shouldn't. Khi câu hỏi có I, người nghe trả lời bằng you: Should I stay? No, you shouldn't.",
      "example": "No, you shouldn't.",
      "formula": [
        [
          "Should I stay?",
          "→",
          "No, you shouldn't."
        ],
        [
          "Should he talk to the fox?",
          "→",
          "No, he shouldn't."
        ]
      ],
      "usage": "Sau No, dùng đại từ phù hợp rồi dùng shouldn't.",
      "exampleVi": "Không, bạn không nên.",
      "sentenceType": "Negative (Câu phủ định)"
    },
    {
      "tag": "Ý nghĩa · Lời khuyên",
      "note": "Con cần hiểu tình huống trước khi chọn. Hành động có lợi hoặc an toàn thường dùng should; hành động có hại, nguy hiểm hoặc không phù hợp thường dùng shouldn't.",
      "example": "You shouldn't eat junk food.",
      "formula": [
        [
          "healthy / safe",
          "→",
          "should"
        ],
        [
          "unhealthy / unsafe",
          "→",
          "shouldn't"
        ]
      ],
      "usage": "Con cần hiểu tình huống trước khi chọn.",
      "exampleVi": "Bạn không nên ăn đồ ăn vặt.",
      "sentenceType": "Negative (Câu phủ định)"
    },
    {
      "tag": "Phát âm · Should",
      "note": "Trong câu nói tự nhiên, should thường được đọc nhẹ /ʃəd/. Với shouldn't, con giữ cụm âm cuối đủ rõ để người nghe nhận ra nghĩa phủ định; câu hỏi Yes/No lên giọng nhẹ ở cuối.",
      "example": "You shouldn't stay.",
      "formula": [
        [
          "You should run.",
          "·",
          "You shouldn't stay."
        ],
        [
          "Should I stop?",
          "↗"
        ]
      ],
      "usage": "Trong câu nói tự nhiên, should thường được đọc nhẹ /ʃəd/.",
      "exampleVi": "Bạn không nên ở lại.",
      "sentenceType": "Negative (Câu phủ định)"
    }
  ],
