{"id":"starter","kind":"practice","title":"Starter - Welcome back!","sourceLessons":["lesson-1"],"items":[{"id":"family-friends-2-program-starter-1","type":"choice","title":"Starter","scene":"I ___ got brown hair.","prompt":"Complete the sentence.","spokenScene":"I ___ got brown hair.","answer":"have","options":["have","has","is","am"],"skill":"grammar","why":"I have got brown hair.","source":{"url":"https://drive.google.com/file/d/1mUlE3tIqjpno2_YNNLk4auNy5U3sV_ce/view","page":4},"sourceLabel":"Family and Friends 2 · Starter pp. 4–7 · centre practice"},{"id":"family-friends-2-program-starter-2","type":"choice","title":"Starter","scene":"He ___ got green eyes.","prompt":"Complete the sentence.","spokenScene":"He ___ got green eyes.","answer":"has","options":["are","am","have","has"],"skill":"grammar","why":"He has got green eyes.","source":{"url":"https://drive.google.com/file/d/1mUlE3tIqjpno2_YNNLk4auNy5U3sV_ce/view","page":4},"sourceLabel":"Family and Friends 2 · Starter pp. 4–7 · centre practice"},{"id":"family-friends-2-program-starter-3","type":"choice","title":"Starter","scene":"She has got a red bag.","prompt":"Choose the short form.","spokenScene":"She has got a red bag.","answer":"She’s got a red bag.","options":["She’re got a red bag.","She’ve got a red bag.","She’s got a red bag.","She got is a red bag."],"skill":"dialogue","why":"She has got a red bag. → She’s got a red bag.","source":{"url":"https://drive.google.com/file/d/1mUlE3tIqjpno2_YNNLk4auNy5U3sV_ce/view","page":4},"sourceLabel":"Family and Friends 2 · Starter pp. 4–7 · centre practice"},{"id":"family-friends-2-program-starter-4","type":"choice","title":"Starter","scene":"We ___ got two toys.","prompt":"Complete the sentence.","spokenScene":"We ___ got two toys.","answer":"have","options":["am","have","has","is"],"skill":"grammar","why":"We have got two toys.","source":{"url":"https://drive.google.com/file/d/1mUlE3tIqjpno2_YNNLk4auNy5U3sV_ce/view","page":4},"sourceLabel":"Family and Friends 2 · Starter pp. 4–7 · centre practice"},{"id":"family-friends-2-program-starter-5","type":"choice","title":"Starter","scene":"There ___ one teddy.","prompt":"Complete the sentence.","spokenScene":"There ___ one teddy.","answer":"is","options":["is","have","do","are"],"skill":"grammar","why":"There is one teddy.","source":{"url":"https://drive.google.com/file/d/1mUlE3tIqjpno2_YNNLk4auNy5U3sV_ce/view","page":4},"sourceLabel":"Family and Friends 2 · Starter pp. 4–7 · centre practice"},{"id":"family-friends-2-program-starter-6","type":"choice","title":"Starter","scene":"There ___ three cars.","prompt":"Complete the sentence.","spokenScene":"There ___ three cars.","answer":"are","options":["am","is","has","are"],"skill":"grammar","why":"There are three cars.","source":{"url":"https://drive.google.com/file/d/1mUlE3tIqjpno2_YNNLk4auNy5U3sV_ce/view","page":4},"sourceLabel":"Family and Friends 2 · Starter pp. 4–7 · centre practice"},{"id":"family-friends-2-program-starter-7","type":"choice","title":"Starter","scene":"There is one doll.","prompt":"How many dolls are there?","spokenScene":"There is one doll.","answer":"one","options":["three","four","one","two"],"skill":"dialogue","why":"There is one doll. → one","source":{"url":"https://drive.google.com/file/d/1mUlE3tIqjpno2_YNNLk4auNy5U3sV_ce/view","page":4},"sourceLabel":"Family and Friends 2 · Starter pp. 4–7 · centre practice"},{"id":"family-friends-2-program-starter-8","type":"choice","title":"Starter","scene":"My aunt’s child is my ___.","prompt":"Choose the family word.","spokenScene":"My aunt’s child is my ___.","answer":"cousin","options":["grandpa","cousin","mum","dad"],"skill":"grammar","why":"My aunt’s child is my cousin.","source":{"url":"https://drive.google.com/file/d/1mUlE3tIqjpno2_YNNLk4auNy5U3sV_ce/view","page":4},"sourceLabel":"Family and Friends 2 · Starter pp. 4–7 · centre practice"},{"id":"family-friends-2-program-starter-9","type":"choice","title":"Starter","scene":"My mum’s mother is my ___.","prompt":"Choose the family word.","spokenScene":"My mum’s mother is my ___.","answer":"grandma","options":["grandma","brother","sister","cousin"],"skill":"grammar","why":"My mum’s mother is my grandma.","source":{"url":"https://drive.google.com/file/d/1mUlE3tIqjpno2_YNNLk4auNy5U3sV_ce/view","page":4},"sourceLabel":"Family and Friends 2 · Starter pp. 4–7 · centre practice"},{"id":"family-friends-2-program-starter-10","type":"choice","title":"Starter","scene":"You put the pieces together to make a picture.","prompt":"Which toy is it?","spokenScene":"You put the pieces together to make a picture.","answer":"a puzzle","options":["a ball","a kite","a bike","a puzzle"],"skill":"dialogue","why":"You put the pieces together to make a picture. → a puzzle","source":{"url":"https://drive.google.com/file/d/1mUlE3tIqjpno2_YNNLk4auNy5U3sV_ce/view","page":4},"sourceLabel":"Family and Friends 2 · Starter pp. 4–7 · centre practice"},{"id":"family-friends-2-program-starter-11","type":"choice","title":"Starter","scene":"It is a toy bear.","prompt":"Which toy is it?","spokenScene":"It is a toy bear.","answer":"a teddy","options":["a scooter","a car","a teddy","a train"],"skill":"dialogue","why":"It is a toy bear. → a teddy","source":{"url":"https://drive.google.com/file/d/1mUlE3tIqjpno2_YNNLk4auNy5U3sV_ce/view","page":4},"sourceLabel":"Family and Friends 2 · Starter pp. 4–7 · centre practice"},{"id":"family-friends-2-program-starter-12","type":"choice","title":"Starter","scene":"12","prompt":"Choose the number word.","spokenScene":"12","answer":"twelve","options":["eleven","twelve","thirteen","twenty"],"skill":"dialogue","why":"12 → twelve","source":{"url":"https://drive.google.com/file/d/1mUlE3tIqjpno2_YNNLk4auNy5U3sV_ce/view","page":4},"sourceLabel":"Family and Friends 2 · Starter pp. 4–7 · centre practice"},{"id":"family-friends-2-program-starter-13","type":"choice","title":"Starter","scene":"20","prompt":"Choose the number word.","spokenScene":"20","answer":"twenty","options":["twenty","twelve","fifteen","sixteen"],"skill":"dialogue","why":"20 → twenty","source":{"url":"https://drive.google.com/file/d/1mUlE3tIqjpno2_YNNLk4auNy5U3sV_ce/view","page":4},"sourceLabel":"Family and Friends 2 · Starter pp. 4–7 · centre practice"},{"id":"family-friends-2-program-starter-14","type":"choice","title":"Starter","scene":"Listen to Titi.","prompt":"Listen and choose the colour word.","spokenScene":"brown","answer":"brown","options":["blue","yellow","green","brown"],"skill":"listening","why":"brown → brown","source":{"url":"https://drive.google.com/file/d/1mUlE3tIqjpno2_YNNLk4auNy5U3sV_ce/view","page":4},"sourceLabel":"Family and Friends 2 · Starter pp. 4–7 · centre practice"},{"id":"family-friends-2-program-starter-15","type":"choice","title":"Starter","scene":"Listen to Titi.","prompt":"Listen and choose the colour word.","spokenScene":"green","answer":"green","options":["brown","red","green","purple"],"skill":"listening","why":"green → green","source":{"url":"https://drive.google.com/file/d/1mUlE3tIqjpno2_YNNLk4auNy5U3sV_ce/view","page":4},"sourceLabel":"Family and Friends 2 · Starter pp. 4–7 · centre practice"}]}